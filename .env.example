# Jazz Lo-Fi Radio Bot - API Keys and Configuration
# ЕСКЕРТУ: Нақты кілттермен толтырып, файл атауын .env етіп сақтаңыз.
# .env файлы .gitignore-де, GitHub-қа ешқашан жүктелмейді.

# Pexels API кілті (тегін, pexels.com/api тіркеліп бірден аласыз)
# Фон loop видеоны әр жүктеу сайын автоматты, жарқын/түрлі-түсті (vibrant)
# 16:9 stock footage-пен ауыстырады. Кілт бос болса — backgrounds/ папкасындағы
# локал файлдарға сүйенеді.
PEXELS_API_KEY=

# Telegram хабарламалары (қате/сәтті болса хабарлайды)
TELEGRAM_NOTIFY_TOKEN=
TELEGRAM_NOTIFY_CHAT_ID=

# Күніне 1 жүктеу уақыты (UTC)
# AITech (03:30/09:30/15:30) және психология ботымен (03:00/09:00/15:00)
# соқтықпас үшін таңдалды.
POST_TIME=06:00

# Видео ұзақтығы (минут, кездейсоқ осы аралықтан таңдалады)
JAZZ_MIN_MINUTES=70
JAZZ_MAX_MINUTES=110

# Базовая директория (обычно текущая папка)
BASE_DIR=.

# YouTube видеоның параметрлері (10 = Music)
YOUTUBE_CATEGORY_ID=10
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_MADE_FOR_KIDS=false

# Қайтара сынау параметрлері
MAX_RETRIES=3
RETRY_DELAY=2
